# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
/.next/
/out/
/build
/dist

# PWA / service worker build artifacts (generated by @serwist/next at build time)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/workbox-*.js
/public/worker-*.js
/public/fallback-*.js

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
/coverage
/playwright-report
/test-results
/.nyc_output

# ---------------------------------------------------------------------------
# Environment & secrets  (NEVER commit — Supabase keys live here)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.p12
*.pfx
secrets.json
service-account*.json

# ---------------------------------------------------------------------------
# Supabase CLI local state
#   NOTE: supabase/migrations/ and supabase/config.toml MUST be committed —
#   they are the source of truth for the database schema and RLS policies.
# ---------------------------------------------------------------------------
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/logs/

# ---------------------------------------------------------------------------
# AI / coding-agent artifacts  (local-only, keep out of the repo)
# ---------------------------------------------------------------------------
AGENTS.md
CLAUDE.md
CLAUDE.local.md
GEMINI.md
.claude/
.claude-*/
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.windsurfrules
.github/copilot-instructions.md
.codeium/
.roo/
.clinerules
*.agent.md
.specstory/
.ai/
.plan/
.plans/

# ---------------------------------------------------------------------------
# Editor / IDE
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Logs & debug
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# ---------------------------------------------------------------------------
# Caches & tooling
# ---------------------------------------------------------------------------
.eslintcache
.prettiercache
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
.vercel

# ---------------------------------------------------------------------------
# Scratch / temp files
# ---------------------------------------------------------------------------
tmp/
temp/
scratch/
*.local
*.bak
*.orig
