# ---------------------------------------------------------------------------
# PharmaDaily — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored and MUST NEVER be committed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
#
# Local dev:  run `npm run db:start` and copy the printed "API URL" + "anon key".
# Hosted:     Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — SERVER ONLY (master key: bypasses Row Level Security)
#
# NEVER prefix this with NEXT_PUBLIC_, never import it into a Client Component,
# never commit it. It is only read by server-side code and the seed scripts.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# First super admin — read ONLY by `npm run seed:admin`, not by the app.
# Use a strong password and rotate it after the first login.
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@pharmadaily.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=System Administrator
